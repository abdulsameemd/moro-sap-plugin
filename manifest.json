{
  "manifestVersion": "1.0",
  "plugin": {
    "name": "moro-sap-plugin",
    "version": "0.1.0",
    "displayName": "DEWA SAP Agentic Development Kit",
    "description": "Full ADK stack for DEWA SAP development — skills, hooks, agents, and commands bundled into one installable package. Covers the complete 11-stage pipeline from Fiori prototype to SAP transport.",
    "author": "DEWA SAP Technical Services · MORO HUB",
    "license": "Proprietary - DEWA Internal",
    "targetTeams": ["SAP Technical Services", "DEWA I&TF", "Any DEWA SAP division"],
    "requires": {
      "claudeCode": ">=1.0.0",
      "mcpServers": [
        "SAPUI5 MCP Server",
        "SAP Fiori MCP Server",
        "abap-mcp-server",
        "SAP CAP MCP Server"
      ]
    }
  },
  "layers": {
    "skills": [
      {
        "name": "moro-design",
        "path": ".claude/skills/moro-design/SKILL.md",
        "layer": 2,
        "criticality": "low",
        "invocation": "invoked"
      },
      {
        "name": "moro-code-review",
        "path": ".claude/skills/moro-code-review/SKILL.md",
        "layer": 2,
        "criticality": "high",
        "invocation": "always-on"
      }
    ],
    "hooks": [
      {
        "name": "pre-lint-gate",
        "event": "PreToolUse",
        "matcher": "Write|Edit|MultiEdit",
        "path": ".claude/hooks/pre-lint-gate.js",
        "layer": 3,
        "stage": [3, 4]
      },
      {
        "name": "post-atc-check",
        "event": "PostToolUse",
        "matcher": "mcp__abap-mcp-server__writeObjectSource",
        "path": ".claude/hooks/post-atc-check.js",
        "layer": 3,
        "stage": [5]
      },
      {
        "name": "session-start-handoff",
        "event": "SessionStart",
        "matcher": null,
        "path": ".claude/hooks/session-start-handoff.js",
        "layer": 3,
        "stage": "all"
      },
      {
        "name": "stop-confirm-review",
        "event": "Stop",
        "matcher": null,
        "path": ".claude/hooks/stop-confirm-review.js",
        "layer": 3,
        "stage": [7]
      },
      {
        "name": "stop-approve-transport",
        "event": "Stop",
        "matcher": null,
        "path": ".claude/hooks/stop-approve-transport.js",
        "layer": 3,
        "stage": [11]
      }
    ],
    "agents": [
      { "name": "design-agent",   "model": "claude-sonnet-4-20250514", "tools": "fiori-mcp-only", "stage": [1,2,3], "status": "stub" },
      { "name": "backend-agent",  "model": "claude-sonnet-4-20250514", "tools": "abap-mcp-only",  "stage": [4,5,6], "status": "stub" },
      { "name": "review-agent",   "model": "claude-opus-4-20250514",   "tools": "read-only",      "stage": [7],     "status": "stub" },
      { "name": "ts-agent",       "model": "claude-sonnet-4-20250514", "tools": "docs-only",      "stage": [8],     "status": "stub" },
      { "name": "security-agent", "model": "claude-opus-4-20250514",   "tools": "read-only",      "stage": "any",   "status": "stub" },
      { "name": "deploy-agent",   "model": "claude-sonnet-4-20250514", "tools": "adt-only",       "stage": [9,10,11],"status": "stub" }
    ],
    "commands": [
      { "name": "dewa-start",  "trigger": "/moro-start",  "path": ".claude/commands/moro-start.md",  "stages": [1,2,3] },
      { "name": "dewa-review", "trigger": "/moro-review", "path": ".claude/commands/moro-review.md", "stages": [7] },
      { "name": "dewa-deploy", "trigger": "/moro-deploy", "path": ".claude/commands/moro-deploy.md", "stages": [9,10,11] }
    ]
  },
  "install": {
    "settingsJson": ".claude/settings.json",
    "configFiles": "docs/",
    "notes": "Run `node scripts/install.js <project-path>` to install into a project. The install script copies all layers into the target project and wires settings.json automatically."
  }
}
