{
  "name": "moro-sap-plugin",
  "version": "1.0.0",
  "description": "MORO HUB SAP SDLC Agentic Toolkit – 5-layer framework for governed SAP development",
  "author": "MORO HUB – SAP Technical Services",
  "license": "Proprietary",
  "layers": {
    "layer1": {
      "name": "Configuration",
      "status": "complete",
      "description": "13 .md configuration files loaded at every session start",
      "files": [
        "docs/CLAUDE.md",
        "docs/CLAUDE_BACKEND.md",
        "docs/GUARDRAILS.md",
        "docs/DEPLOY.md",
        "docs/CODEREVIEW.md",
        "docs/DESIGN.md",
        "docs/SAP_CLEAN_CORE.md",
        "docs/TS_TEMPLATE.md",
        "docs/INTEGRATION.md",
        "docs/METRICS.md",
        "docs/PROMPTS_BACKEND.md",
        "docs/SKILL_SPECIFICATIONS.md",
        "docs/OPUS_SKILL_PROMPTS.md"
      ]
    },
    "layer2": {
      "name": "Skills",
      "status": "complete",
      "description": "2 agentskills.io-compliant skills with scoped tool access and DEWA security metadata",
      "skills": [
        {
          "name": "moro-design",
          "criticality": "low",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Write", "Glob", "Grep"],
          "owner": "Design CoE",
          "path": ".claude/skills/moro-design/SKILL.md"
        },
        {
          "name": "moro-code-review",
          "criticality": "high",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": [
            "mcp__abap__getObjectSource",
            "mcp__abap__reviewAbapCode",
            "mcp__abap__runAtcCheck",
            "mcp__abap__syntaxCheck",
            "mcp__abap__getObjectMetadata"
          ],
          "owner": "RedTeam – Security Findings",
          "path": ".claude/skills/moro-code-review/SKILL.md"
        }
      ]
    },
    "layer3": {
      "name": "Hooks",
      "status": "complete",
      "description": "5 deterministic hook scripts wired into Claude Code – cannot be bypassed",
      "hooks": [
        {
          "event": "PreToolUse",
          "file": ".claude/hooks/pre-lint-gate.js",
          "matcher": "Write|Edit|MultiEdit",
          "description": "Blocks file write if UI5 lint fails"
        },
        {
          "event": "PostToolUse",
          "file": ".claude/hooks/post-atc-check.js",
          "matcher": "writeObjectSource",
          "description": "ATC check after every ABAP write – reverts on failure"
        },
        {
          "event": "SessionStart",
          "file": ".claude/hooks/session-start-handoff.js",
          "matcher": null,
          "description": "Auto-loads handoff context at session start"
        },
        {
          "event": "Stop",
          "file": ".claude/hooks/stop-confirm-review.js",
          "matcher": null,
          "description": "Blocks session end without CONFIRM REVIEW"
        },
        {
          "event": "Stop",
          "file": ".claude/hooks/stop-approve-transport.js",
          "matcher": null,
          "description": "Blocks transport release without APPROVE TRANSPORT"
        }
      ]
    },
    "layer4": {
      "name": "Subagents",
      "status": "complete",
      "description": "6 specialist agents – each invoked explicitly by the developer for their SDLC stage",
      "agents": [
        {
          "name": "design-agent",
          "command": "/moro-start",
          "stages": "1-3",
          "criticality": "low",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Write", "Glob", "Grep", "mcp__sapui5__*"],
          "path": ".claude/agents/design-agent.md"
        },
        {
          "name": "backend-agent",
          "command": "/moro-backend",
          "stages": "4-6",
          "criticality": "high",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Glob", "Grep", "mcp__abap__getObjectSource", "mcp__abap__getObjectMetadata", "mcp__abap__searchObject", "mcp__abap__syntaxCheck", "mcp__abap__writeObjectSource"],
          "path": ".claude/agents/backend-agent.md"
        },
        {
          "name": "review-agent",
          "command": "/moro-review",
          "stages": "7",
          "criticality": "high",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Glob", "Grep", "mcp__abap__getObjectSource", "mcp__abap__reviewAbapCode", "mcp__abap__runAtcCheck", "mcp__sapui5__run_ui5_linter", "mcp__sapui5__run_manifest_validation"],
          "path": ".claude/agents/review-agent.md"
        },
        {
          "name": "ts-agent",
          "command": "/moro-ts",
          "stages": "8",
          "criticality": "low",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Write", "Glob", "Grep"],
          "path": ".claude/agents/ts-agent.md"
        },
        {
          "name": "security-agent",
          "command": "/moro-security",
          "stages": "9",
          "criticality": "high",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Glob", "Grep", "mcp__abap__getObjectSource", "mcp__abap__reviewAbapCode", "mcp__abap__runAtcCheck"],
          "path": ".claude/agents/security-agent.md"
        },
        {
          "name": "deploy-agent",
          "command": "/moro-deploy",
          "stages": "10-11",
          "criticality": "high",
          "llm-type": "cloud",
          "model": "claude-sonnet-4-20250514",
          "allowed-tools": ["Read", "Glob", "mcp__abap__getTransportDetails", "mcp__abap__listTransports", "mcp__abap__validateTransport", "mcp__abap__getObjectMetadata"],
          "path": ".claude/agents/deploy-agent.md"
        }
      ]
    },
    "layer5": {
      "name": "Plugin",
      "status": "complete",
      "description": "Installable plugin package – clone, validate, install in 3 commands",
      "scripts": {
        "validate": "scripts/validate.js",
        "install": "scripts/install.js"
      }
    }
  },
  "commands": [
    { "name": "moro-start",    "path": ".claude/commands/moro-start.md",    "agent": "design-agent",   "stages": "1-3"   },
    { "name": "moro-backend",  "path": ".claude/commands/moro-backend.md",  "agent": "backend-agent",  "stages": "4-6"   },
    { "name": "moro-review",   "path": ".claude/commands/moro-review.md",   "agent": "review-agent",   "stages": "7"     },
    { "name": "moro-ts",       "path": ".claude/commands/moro-ts.md",       "agent": "ts-agent",       "stages": "8"     },
    { "name": "moro-security", "path": ".claude/commands/moro-security.md", "agent": "security-agent", "stages": "9"     },
    { "name": "moro-deploy",   "path": ".claude/commands/moro-deploy.md",   "agent": "deploy-agent",   "stages": "10-11" }
  ],
  "governance": {
    "human-gates": [
      { "gate": "CONFIRM REVIEW",    "hook": "stop-confirm-review.js",    "stage": 7  },
      { "gate": "APPROVE TRANSPORT", "hook": "stop-approve-transport.js", "stage": 11 }
    ],
    "validation-checks": 38,
    "published": "https://github.com/abdulsameemd/moro-sap-plugin"
  }
}
